{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/invoices",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron/tracking",
      "schedule": "0 2 * * *"
    }
  ]
}
